# Sanity – public (safe to expose in the browser)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=

# Sanity – server-side (Next.js API routes / server components)
SANITY_API_PROJECT_ID=
SANITY_API_DATASET=
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=

# Sanity – Studio / CLI
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=

# Server-only. Opens Next.js draft mode at /api/draft.
SANITY_PREVIEW_SECRET=

# Server-only. Validates the Sanity webhook at /api/revalidate.
SANITY_REVALIDATE_SECRET=
